{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sraz-XX/event.md (front matter)",
  "type": "object",
  "required": ["number", "name", "date", "url", "image", "partner"],
  "properties": {
    "number": {"type": "integer", "minimum": 1, "description": "číslo srazu"},
    "name": {"type": "string", "minLength": 1, "description": "název akce bez čísla"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "time": {"type": "string", "pattern": "^\\d{1,2}:\\d{2}$"},
    "venue": {"type": "string"},
    "url": {"type": "string"},
    "image": {"type": "string", "description": "ilustrace slona, cesta relativně k event.md"},
    "partner": {
      "type": "object",
      "required": ["name", "logo"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "logo": {"type": "string", "description": "SVG logo, cesta relativně k event.md"}
      }
    }
  }
}
